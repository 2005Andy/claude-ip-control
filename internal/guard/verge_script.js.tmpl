// claude-ip-control guard: Clash Verge *global* extension Script.
// Generated by `claude-ip-control guard render-verge-script`; edit guard.json
// and regenerate instead of editing this file.
//
// Routing built here:
//   guarded domains/CIDRs -> GUARD group = [REJECT, EXIT group]
//     EXIT group (fallback) = [exit node chained via UPPER, exit node direct]
//     Both members leave from the same egress IP. The daemon selects the EXIT
//     group only while that IP is verified; otherwise REJECT.
//   everything else -> DEFAULT group (fallback) = [chained exit, UPPER]
//     so a site or outage the exit cannot serve falls back to UPPER.
//   UDP (optional) -> UPPER, because an HTTP exit node cannot carry UDP.

const GUARD = __GUARD_CONFIG__;

function main(config, profileName) {
  const proxies = config.proxies || [];
  const byName = {};
  proxies.forEach(function (p) { if (p && p.name) byName[p.name] = p; });
  const groupNames = {};
  (config["proxy-groups"] || []).forEach(function (g) { if (g && g.name) groupNames[g.name] = true; });
  const exit = byName[GUARD.exit_proxy];
  const hasUpper = !!byName[GUARD.upper_proxy] || !!groupNames[GUARD.upper_proxy];
  const chainName = GUARD.exit_proxy + " [chain]";
  const managed = [GUARD.guard_group, GUARD.exit_group, GUARD.default_group];

  config.proxies = proxies.filter(function (p) { return !(p && p.name === chainName); });
  const exitMembers = [];
  if (exit && GUARD.chain_exit && hasUpper) {
    const chained = Object.assign({}, exit, { name: chainName, "dialer-proxy": GUARD.upper_proxy });
    config.proxies.push(chained);
    exitMembers.push(chainName);
  }
  if (exit) exitMembers.push(GUARD.exit_proxy);

  const health = { url: GUARD.health_url, interval: GUARD.health_interval_seconds, lazy: false };
  const groups = (config["proxy-groups"] || []).filter(function (g) { return g && managed.indexOf(g.name) < 0; });
  const added = [];
  if (exitMembers.length > 0) {
    added.push(Object.assign({ name: GUARD.exit_group, type: "fallback", proxies: exitMembers }, health));
    added.push({ name: GUARD.guard_group, type: "select", proxies: ["REJECT", GUARD.exit_group] });
  } else {
    added.push({ name: GUARD.guard_group, type: "select", proxies: ["REJECT"] });
  }
  const defaultMembers = exitMembers.slice(0, 1);
  if (hasUpper) defaultMembers.push(GUARD.upper_proxy);
  if (defaultMembers.length === 0) defaultMembers.push("DIRECT");
  added.push(Object.assign({ name: GUARD.default_group, type: "fallback", proxies: defaultMembers }, health));
  config["proxy-groups"] = added.concat(groups);

  const listeners = (config.listeners || []).filter(function (l) { return l && l.name !== "claude-guard-probe"; });
  listeners.push({
    name: "claude-guard-probe", type: "http", listen: GUARD.probe_listen, port: GUARD.probe_port,
    proxy: exitMembers.length > 0 ? GUARD.exit_group : "REJECT",
  });
  config.listeners = listeners;

  // Sniff SNI/Host so connections to raw IPs still match the domain rules.
  const sniffer = config.sniffer || {};
  sniffer.enable = true;
  sniffer["override-destination"] = false;
  sniffer["parse-pure-ip"] = true;
  sniffer.sniff = Object.assign({ HTTP: { ports: [80] }, TLS: { ports: [443] } }, sniffer.sniff || {});
  config.sniffer = sniffer;

  const rules = GUARD.domains.map(function (d) { return "DOMAIN-SUFFIX," + d + "," + GUARD.guard_group; })
    .concat(GUARD.cidrs.map(function (c) {
      return (c.indexOf(":") >= 0 ? "IP-CIDR6," : "IP-CIDR,") + c + "," + GUARD.guard_group + ",no-resolve";
    }));
  if (GUARD.other_traffic === "profile") {
    config.rules = rules.concat((config.rules || []).filter(function (r) {
      return String(r).indexOf("," + GUARD.guard_group) < 0;
    }));
  } else {
    if (hasUpper) {
      GUARD.upper_domains.forEach(function (d) { rules.push("DOMAIN-SUFFIX," + d + "," + GUARD.upper_proxy); });
      if (GUARD.udp_via_upper) rules.push("NETWORK,UDP," + GUARD.upper_proxy);
    }
    rules.push("MATCH," + GUARD.default_group);
    config.rules = rules;
  }
  config.mode = "rule";
  return config;
}
